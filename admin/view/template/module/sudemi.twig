{# sudemi > Settings: connecting the shop, whether sudemi shows it, delivery times, the catalogue.
   OpenCart 4 switches Twig's autoescaping OFF, so it is switched on explicitly for this whole
   page: every value is HTML-escaped. Only OpenCart's own header, menu and footer markup and the
   sudemi header (rendered escaped by sudemi_nav.twig) are printed raw.
   (Security fix 2026-11-07: a support message containing HTML was rendered as HTML.) #}
{% autoescape 'html' %}
{{ header|raw }}{{ column_left|raw }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <h1>{{ text_settings_title }}</h1>
      <ol class="breadcrumb"><li class="breadcrumb-item"><a href="{{ home_href }}">{{ text_home }}</a></li><li class="breadcrumb-item">sudemi</li><li class="breadcrumb-item">{{ text_settings_title }}</li></ol>
    </div>
  </div>

  <div class="container-fluid">
    {{ sudemi_nav|raw }}
    <div id="alert" class="toast-container position-fixed top-0 end-0 p-3"></div>

    {% if not supported %}
      <div class="alert alert-danger">{{ text_sodium_missing }}</div>
    {% endif %}
    {% if currency.warning %}
      <div class="alert alert-danger" id="sudemi-currency-warning">{{ currency.warning }}</div>
    {% endif %}

    {% if connected %}
      <div class="row g-3">
        <div class="col-xl-7">
          {# Whether sudemi is showing this shop's products, in sudemi's own words. Worth its own
             block because the failure it reports is invisible from here: products stop being
             listed when the beats stop arriving, and from this side everything looks normal. The
             usual cause is no cron entry on the host. #}
          <div class="sudemi-card" id="sudemi-listing-status">
            <div class="sudemi-card-head"><h2>{{ text_listing_status }}</h2></div>
            <div class="sudemi-card-body">
              {% if not status %}
                <div class="alert alert-warning">{{ text_never_reported }}</div>
              {% elseif not status.reachable %}
                <div class="alert alert-danger">{{ text_unreachable }}</div>
              {% elseif not status.connected %}
                <div class="alert alert-danger">{{ status.message }}</div>
              {% elseif not status.listed %}
                <div class="alert alert-warning">{{ status.reason }}</div>
              {% else %}
                <div class="alert alert-success mb-3"><i class="fa-solid fa-circle-check"></i> {{ text_listed }}</div>
              {% endif %}
              <dl class="sudemi-dl">
                <dt>{{ entry_pending }}</dt><dd><strong>{{ pending }}</strong><div class="sudemi-muted">{{ text_pending }}</div></dd>
                {% if status.trusted_until %}<dt>{{ entry_trusted_until }}</dt><dd><code>{{ status.trusted_until }}</code><div class="sudemi-muted">{{ text_trusted_until }}</div></dd>{% endif %}
                <dt>{{ entry_cron }}</dt><dd><code style="word-break:break-all">*/5 * * * * curl -fsS "{{ cron_url }}" &gt;/dev/null</code><div class="sudemi-muted">{{ text_cron }}</div></dd>
              </dl>
            </div>
          </div>

          <div class="sudemi-card" id="sudemi-connection">
            <div class="sudemi-card-head"><h2>{{ text_connection_title }}</h2><span class="sudemi-badge sudemi-badge-on">{{ text_connected }}</span></div>
            <div class="sudemi-card-body">
              <dl class="sudemi-dl">
                <dt>{{ entry_shop_url }}</dt><dd><code>{{ shop_url }}</code><div class="sudemi-muted">{{ text_shop_url_fixed }}</div></dd>
                <dt>{{ entry_currency }}</dt><dd><code id="sudemi-currency">{{ currency.code }}</code><div class="sudemi-muted">{{ currency.text }}{% if currency.fee %} {{ currency.fee }}{% endif %}</div>
                  {% if currency.changed %}<div class="alert alert-warning mt-2 mb-0">{{ currency.changed }}</div>{% endif %}</dd>
                <dt>{{ entry_install }}</dt><dd><code>{{ install_id }}</code></dd>
                <dt>{{ entry_key }}</dt><dd><code>{{ text_key_here }}</code><div class="sudemi-muted">{{ text_key_held }}</div></dd>
              </dl>
              <p class="sudemi-muted mt-3 mb-3">{{ text_locked }}</p>
              <button class="btn btn-outline-danger btn-sm" onclick="if (confirm('{{ text_disconnect_confirm|e('js') }}')) { sudemiPost('disconnect'); }"><i class="fa-solid fa-link-slash"></i> {{ button_disconnect }}</button>
            </div>
          </div>
        </div>

        <div class="col-xl-5">
          <div class="sudemi-card" id="sudemi-catalogue">
            <div class="sudemi-card-head"><h2>{{ text_catalogue_title }}</h2></div>
            <div class="sudemi-card-body">
              <p class="sudemi-muted">{{ text_catalogue_intro }}</p>
              {% if options_skipped %}<div class="alert alert-info">{{ text_options_skipped|format(options_skipped) }}</div>{% endif %}
              <button class="btn btn-primary" onclick="sudemiPost('sync')"><i class="fa-solid fa-rotate"></i> {{ button_sync }}</button>
              <a class="btn btn-outline-secondary" href="{{ products_href }}"><i class="fa-solid fa-box-open"></i> {{ text_menu_products }}</a>
            </div>
          </div>

          <div class="sudemi-card" id="sudemi-delivery">
            <div class="sudemi-card-head"><h2>{{ text_delivery_title }}</h2></div>
            <div class="sudemi-card-body">
              {% if shipping_preview %}
                <p class="mb-1">{{ text_delivery_preview }}</p>
                <div class="d-flex flex-wrap gap-1 mb-2">{% for rate in shipping_preview %}<span class="sudemi-badge sudemi-badge-muted">{{ rate.country }} {{ rate.amount }}</span>{% endfor %}</div>
                <div class="sudemi-muted mb-3">{{ text_delivery_skipped }} <a href="{{ shipping_href }}">{{ text_menu_shipping }}</a></div>
              {% else %}
                <div class="alert alert-warning">{{ text_delivery_none }}</div>
              {% endif %}
              <div class="row g-2 align-items-end">
                <div class="col-sm-6"><label class="form-label" for="sudemi-handling">{{ entry_handling_days }}</label>
                  <div class="input-group"><input id="sudemi-handling" type="number" min="0" max="60" class="form-control" value="{{ handling_days }}"/><span class="input-group-text">{{ text_days }}</span></div></div>
                <div class="col-sm-6"><label class="form-label" for="sudemi-transit">{{ entry_transit_days }}</label>
                  <div class="input-group"><input id="sudemi-transit" type="number" min="0" max="60" class="form-control" value="{{ transit_days }}"/><span class="input-group-text">{{ text_days }}</span></div></div>
              </div>
              <div class="sudemi-muted my-2">{{ text_delivery_help }}</div>
              <button class="btn btn-outline-primary" onclick="sudemiDelivery()"><i class="fa-solid fa-floppy-disk"></i> {{ button_delivery }}</button>
            </div>
          </div>
        </div>
      </div>

    {% elseif claim_url %}
      <div class="sudemi-card" id="sudemi-claim">
        <div class="sudemi-card-body text-center py-5">
          <i class="fa-solid fa-link fa-2x mb-3" style="color:#2b59d6"></i>
          <h2 class="h4">{{ text_claim_title }}</h2>
          <p class="sudemi-muted mx-auto" style="max-width:36rem">{{ text_not_confirmed }}</p>
          <a class="btn btn-primary" target="_blank" rel="noopener noreferrer" href="{{ claim_url }}">{{ button_confirm }}</a>
          <button class="btn btn-outline-secondary" onclick="sudemiPost('check')">{{ button_check }}</button>
        </div>
      </div>

    {% else %}
      <div class="sudemi-card" id="sudemi-welcome">
        <div class="sudemi-card-body py-5">
          <div class="row align-items-center g-4">
            <div class="col-lg-8">
              <h2 class="h3 mb-3">{{ text_welcome_title }}</h2>
              <p class="mb-3">{{ text_intro }}</p>
              <ul class="list-unstyled sudemi-muted mb-4">
                <li class="mb-2"><i class="fa-solid fa-check text-success"></i> {{ text_welcome_point_1 }}</li>
                <li class="mb-2"><i class="fa-solid fa-check text-success"></i> {{ text_welcome_point_2 }}</li>
                <li class="mb-2"><i class="fa-solid fa-check text-success"></i> {{ text_welcome_point_3 }}</li>
              </ul>
              <button class="btn btn-primary btn-lg" {% if not supported %}disabled{% endif %} onclick="sudemiPost('connect')"><i class="fa-solid fa-plug"></i> {{ button_connect }}</button>
            </div>
          </div>
        </div>
      </div>
    {% endif %}

    {% if log %}
      <div class="sudemi-card" id="sudemi-activity">
        <div class="sudemi-card-head"><h2>{{ text_activity_title }}</h2></div>
        <div class="table-responsive">
          <table class="table table-sm sudemi-table">
            {% for entry in log %}
              <tr{% if loop.index > 12 %} class="sudemi-log-more" hidden{% endif %}><td class="text-nowrap sudemi-muted" style="width:13rem">{{ entry.at }}</td><td>{{ entry.message }}</td></tr>
            {% endfor %}
          </table>
        </div>
        {% if log|length > 12 %}<div class="sudemi-card-body pt-2"><button type="button" class="btn btn-sm btn-light" onclick="document.querySelectorAll('.sudemi-log-more').forEach(function (r) { r.hidden = false; }); this.remove();">{{ button_show_all }}</button></div>{% endif %}
      </div>
    {% endif %}
  </div>
</div>

<script type="text/javascript">
// The user token travels in the query string, which is how OpenCart's admin authenticates an
// AJAX call; the controller compares it with hash_equals before doing anything.
function sudemiDelivery() {
    $.ajax({
        url: 'index.php?route=extension/sudemi/module/sudemi.delivery&user_token={{ user_token|e('js') }}',
        type: 'post', dataType: 'json',
        data: { handling_days: $('#sudemi-handling').val(), transit_days: $('#sudemi-transit').val() },
        success: function (json) { if (json.error) { alert(json.error); } else { location.reload(); } }
    });
}

function sudemiPost(action) {
    $.ajax({
        url: 'index.php?route=extension/sudemi/module/sudemi.' + action + '&user_token={{ user_token|e('js') }}',
        type: 'post',
        dataType: 'json',
        success: function (json) {
            if (json.error) { alert(json.error); }
            if (json.success) { alert(json.success); location.reload(); }
            if (json.claim_url) { window.open(json.claim_url, '_blank', 'noopener'); location.reload(); }
        },
        error: function () { alert('{{ error_request_failed|e('js') }}'); }
    });
}
</script>
{{ footer|raw }}
{% endautoescape %}
